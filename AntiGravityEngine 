G_NEWTON = 6.674e-11      # гравитационная постоянная (СИ)
PI = math.pi

# Параметры по умолчанию
ALPHA_DEFAULT = 1.0       # коэффициент связи
M_N_DEFAULT = 1.0         # масса внутреннего слоя
DM_DEFAULT = 0.1          # разность масс M_{n+1} - M_n


