def _check(name: str, cond: bool):
    if not cond:
        raise AssertionError(f"FAIL: {name}")
    print(f"  OK  {name}")


def run_tests():
    print("=" * 70)
    print("ΔM-ANTIGRAVITY — TESTS")
    print("=" * 70)

    print("\n[1] ξ(x) свойства")
    _check("ξ(0) ∈ (0, 1)", 0 < DeltaMassGravity.xi(0) < 1)
    _check("ξ(1) = 0.5", abs(DeltaMassGravity.xi(1.0) - 0.5) < 1e-12)
    _check("ξ(∞) → 0", DeltaMassGravity.xi(1000.0) < 1e-12)
    _check("ξ монотонна", DeltaMassGravity.xi(0.5) > DeltaMassGravity.xi(2.0))

    print("\n[2] r_eq формула")
    g = DeltaMassGravity(alpha=1.0)
    req = g.r_eq(M_n=1.0, dM=0.1)
    _check("r_eq > 0", req > 0 and math.isfinite(req))
    _check("r_eq(ΔM↑) ↓", g.r_eq(1.0, 0.2) < g.r_eq(1.0, 0.1))
    _check("r_eq(ΔM=0) = ∞", g.r_eq(1.0, 0.0) == float('inf'))

    print("\n[3] Знак g(r)")
    M_n, M_next = 1.0, 1.1
    _check("r << r_eq: antigravity",
           g.sign_at(0.1 * req, M_n, M_next) == "antigravity")
    _check("r << r_eq: antigravity",
           g.sign_at(0.5 * req, M_n, M_next) == "antigravity")
    _check("r >> r_eq: gravity",
           g.sign_at(2.0 * req, M_n, M_next) == "gravity")
    _check("r >> r_eq: gravity",
           g.sign_at(10.0 * req, M_n, M_next) == "gravity")

    print("\n[4] Равновесие")
    s_eq = g.state_at(req, M_n, M_next)
    _check("|g(r_eq)| мало", abs(s_eq.g_total) < 1e-3)
    _check("ξ(r_eq) = 0.5", abs(s_eq.xi - 0.5) < 1e-6)

    print("\n[5] Численный поиск r_eq")
    req_num = g.find_r_eq_numeric(M_n, M_next,
                                   r_max=10 * req,
                                   tol=1e-12)
    rel_err = abs(req_num - req) / req
    _check(f"аналитика vs численно (Δ={rel_err:.2e})",
           rel_err < 1e-3)

    print("\n[6] ΔM = 0")
    _check("нет антигравитации",
           g.sign_at(0.1, 1.0, 1.0) == "gravity")

    print("\n[7] ΔM < 0")
    g_neg = DeltaMassGravity(alpha=1.0)
    req_neg = g_neg.r_eq(1.0, -0.1)
    _check("r_eq(ΔM<0) > 0", req_neg > 0)
    # При ΔM<0 антигравитация направлена внутрь → g < 0 везде
    _check("ΔM<0: g < 0",
           g_neg.g_at_r(0.5 * req_neg, 1.0, 0.9) < 0)

    print("\n[8] Soft core")
    g_soft = DeltaMassGravity(alpha=1.0, soft_core=0.01)
    _check("нет бесконечности", math.isfinite(g_soft.g_at_r(0.0, 1.0, 1.1)))

    print("\n[9] Профиль")
    prof = g.profile(M_n, M_next, n_points=50)
    _check("50 точек", len(prof) == 50)
    _check("есть antigravity", any(s.sign == "antigravity" for s in prof))
    _check("есть gravity", any(s.sign == "gravity" for s in prof))

    print("\n[10] Регрессия: r_eq не меняется при масштабировании")
    g2 = DeltaMassGravity(alpha=2.0)
    req2 = g2.r_eq(1.0, 0.1)
    _check("r_eq(α=2) < r_eq(α=1)", req2 < req)

    print()
    print("=" * 70)
    print("✅ ВСЕ ТЕСТЫ ПРОЙДЕНЫ (10 групп)")
    print("=" * 70)


